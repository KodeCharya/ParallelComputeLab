# Static analysis configuration.
# The project compiles clean with -Wall -Wextra -Wpedantic -Wconversion, so most
# clang-tidy checks below are intentionally conservative: performance kernels
# legitimately use reinterpret_cast and raw pointers for alignment handling.
Checks: >
  -*,
  bugprone-*,
  performance-*,
  readability-*,
  modernize-use-nullptr,
  modernize-use-override,
  modernize-use-emplace,
  -readability-magic-numbers,
  -readability-identifier-length,
  -readability-function-cognitive-complexity,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  -performance-no-int-to-ptr

WarningsAsErrors: ''
HeaderFilterRegex: 'include/parallel_compute/.*|src/.*'
FormatStyle: file
CheckOptions:
  - key: readability-braces-around-statements.ShortStatementLines
    value: '2'
